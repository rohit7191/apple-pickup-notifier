# Copy this file to .env and set your own values. Never commit .env.
# The part numbers below are example US models; keep only those you want to monitor.
APPLE_PART_NUMBERS="MFXH4LL/A,MFXJ4LL/A,MJQ34LL/A,MJW44LL/A"
APPLE_ZIP="YOUR_ZIP_CODE"
APPLE_SKU_NAMES='{"MFXH4LL/A":"iPhone 17 Pro Max Cosmic Orange 256 GB","MFXJ4LL/A":"iPhone 17 Pro Max Deep Blue 256 GB","MJQ34LL/A":"iPhone 18 Pro Black 256 GB","MJW44LL/A":"iPhone 18 Pro Max Black 256 GB"}'
# Fill in both values to enable Pushover, or leave them empty for log-only checks.
PUSHOVER_USER=
PUSHOVER_TOKEN=
APPLE_MODEL_URL="https://www.apple.com/shop/buy-iphone/iphone-18-pro"
DEBUG=
